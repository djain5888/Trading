# Titan backend configuration example.
# Copy to `.env` and adjust for your environment. Unset values fall back to the
# defaults shown below; in production the required secrets must be provided.

# --- Application ---
APP_NAME=Titan
APP_VERSION=0.1.0
ENVIRONMENT=development           # development | testing | production
DEBUG=false

# --- Market data provider ---
MARKET_DATA_PROVIDER=groww        # groww (real httpx) | groww_sdk (growwapi SDK) | fake (offline skeleton)

# --- Logging ---
LOG_LEVEL=INFO

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]               # JSON array of allowed origins

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=titan
POSTGRES_USER=titan
POSTGRES_PASSWORD=                # required in production

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- DuckDB ---
DUCKDB_PATH=./titan.duckdb

# --- Groww broker API ---
GROWW_API_KEY=                    # required in production
# Explicit auth mode; the provider honours this exactly (no implicit fallback):
#   token       -> GROWW_API_KEY is a bearer access token (no exchange)
#   key_secret  -> GROWW_API_KEY + GROWW_API_SECRET, checksum exchange (POST /v1/token/api/access)
#   totp        -> GROWW_API_KEY + GROWW_TOTP_SEED
GROWW_AUTH_MODE=token
GROWW_API_SECRET=                 # required when GROWW_AUTH_MODE=key_secret
GROWW_TOTP_SEED=                  # required when GROWW_AUTH_MODE=totp (base32 seed)
GROWW_BASE_URL=https://api.groww.in
GROWW_TIMEOUT_SECONDS=10          # per-request read timeout
GROWW_CONNECT_TIMEOUT_SECONDS=5
GROWW_MAX_RETRIES=3               # transient-failure retries (exponential backoff)
GROWW_THROTTLE_RATE_PER_SECOND=0  # max requests/sec (0 = unlimited)
