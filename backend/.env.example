# Titan backend configuration example.
# Copy to `.env` and adjust for your environment. Unset values fall back to the
# defaults shown below; in production the required secrets must be provided.

# --- Application ---
APP_NAME=Titan
APP_VERSION=0.1.0
ENVIRONMENT=development           # development | testing | production
DEBUG=false

# --- Market data provider ---
MARKET_DATA_PROVIDER=groww        # groww (real) | fake (offline skeleton)

# --- Logging ---
LOG_LEVEL=INFO

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]               # JSON array of allowed origins

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=titan
POSTGRES_USER=titan
POSTGRES_PASSWORD=                # required in production

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- DuckDB ---
DUCKDB_PATH=./titan.duckdb

# --- Groww broker API ---
GROWW_API_KEY=                    # required in production
GROWW_API_SECRET=                 # optional; set for secret-based auth
GROWW_TOTP_SEED=                  # base32 TOTP seed for API-key + TOTP auth
GROWW_BASE_URL=https://api.groww.in
GROWW_TIMEOUT_SECONDS=10          # per-request read timeout
GROWW_CONNECT_TIMEOUT_SECONDS=5
GROWW_MAX_RETRIES=3               # transient-failure retries (exponential backoff)
GROWW_THROTTLE_RATE_PER_SECOND=0  # max requests/sec (0 = unlimited)
