# Titan backend configuration example.
# Copy to `.env` and adjust for your environment. All variables are prefixed
# with TITAN_ and are optional; sensible defaults are applied when unset.

# --- Application ---
TITAN_APP_NAME=Titan
TITAN_APP_VERSION=0.1.0
TITAN_ENVIRONMENT=development
TITAN_DEBUG=false

# --- HTTP server ---
TITAN_HOST=0.0.0.0
TITAN_PORT=8000
TITAN_API_PREFIX=/api/v1

# --- CORS (JSON array of origins) ---
TITAN_CORS_ORIGINS=["*"]

# --- Persistence ---
TITAN_DATABASE_URL=sqlite+aiosqlite:///./titan.db

# --- Logging ---
TITAN_LOG_LEVEL=INFO
